<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file ("Project Object Model").

  Maven reads this file to know:
    1. which libraries (dependencies) the project needs - it downloads them automatically,
    2. how to compile, test and package the code into a runnable .jar file.

  ALWAYS build with the Maven Wrapper (./mvnw), never a globally installed "mvn":
  the wrapper pins the exact Maven version so every machine (and CI) builds identically.
    ./mvnw spring-boot:run   -> start the app
    ./mvnw -B verify         -> compile + run all tests (what CI does)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Inheriting from spring-boot-starter-parent gives us sensible defaults (Java compiler settings,
      plugin configuration) and a curated list of library versions that are known to work together.
      That is why most dependencies below have no <version>: the parent decides it.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.portfolio</groupId>
    <artifactId>roombooking</artifactId>
    <version>1.0.0</version>
    <name>roombooking</name>
    <description>Event / Meeting Room Booking System - REST API</description>

    <properties>
        <java.version>17</java.version>
        <!-- Versions for libraries that the Spring Boot parent does not manage. -->
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.8.13</springdoc.version>
    </properties>

    <dependencies>
        <!-- Spring MVC + embedded Tomcat + Jackson (JSON): everything needed for a REST API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring Data JPA + Hibernate: map Java classes (entities) to database tables. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Bean Validation (@NotBlank, @Min, ...) for request bodies. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring Security: authentication (who are you?) and authorization (what may you do?). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Flyway: versioned SQL migrations (src/main/resources/db/migration) create the schema. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Since Flyway 10, PostgreSQL support lives in a separate module. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- JJWT: create and verify JSON Web Tokens. Only the API is needed at compile time. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Generates OpenAPI docs + Swagger UI (http://localhost:8084/swagger-ui.html) from the controllers. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Databases. "runtime" scope: our code never imports them directly, only JDBC uses them. -->
        <!-- H2 = in-memory database for development and tests (zero setup). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- PostgreSQL driver for the "prod" profile / Docker. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test libraries: JUnit 5, AssertJ, Mockito, MockMvc, Spring test context. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Packages the app as a single executable "fat jar": java -jar target/roombooking-1.0.0.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
