{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Backend (Spring Boot)",
      "request": "launch",
      "mainClass": "com.portfolio.roombooking.RoomBookingApplication",
      "projectName": "roombooking",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "type": "chrome",
      "name": "Frontend (Chrome)",
      "request": "launch",
      "url": "http://localhost:4304",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Frontend: npm start"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (backend + frontend)",
      "configurations": [
        "Backend (Spring Boot)",
        "Frontend (Chrome)"
      ],
      "stopAll": true
    }
  ]
}